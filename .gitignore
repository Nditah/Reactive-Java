# ==========================================
# Maven Build Output (CRITICAL)
# ==========================================
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
# Keep Maven wrapper JAR if you ever add ./mvnw
!.mvn/wrapper/maven-wrapper.jar

# ==========================================
# Node / npm Task Runner Wrapper
# ==========================================
node_modules/
npm-debug.log*
package-lock.json

# ==========================================
# Java Compiled Files, Packages & JVM Crash Logs
# ==========================================
*.class
*.log
*.ctxt
.mtj.tmp/
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*

# ==========================================
# JetBrains IntelliJ IDEA
# ==========================================
.idea/
*.iml
*.iws
*.ipr
out/
/shelf/

# ==========================================
# VS Code (Keep launch.json, ignore local state)
# ==========================================
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json

# ==========================================
# macOS & Environment Secrets
# ==========================================
.DS_Store
.AppleDouble
.LSOverride
.env
.env.*
